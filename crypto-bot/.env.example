# Copy to .env and fill in. NEVER commit the real .env (it is gitignored).
#
# Kraken API keys — create at https://www.kraken.com/u/security/api
# IMPORTANT: grant "Query Funds" + "Create & Modify Orders" ONLY.
# Do NOT enable withdrawal permission. A leaked trade-only key cannot drain funds.
KRAKEN_API_KEY=
KRAKEN_API_SECRET=

# Trading mode: backtest | paper | live   (default paper — live requires this to be set explicitly)
BOT_MODE=paper

# Optional notification webhook (Telegram / email relay). Leave blank to disable.
BOT_NOTIFY_WEBHOOK=
